{
  "schema_version": 1,
  "description": "Historical paper checkpoint registry for the fixed 612/75/78 system split.",
  "runs": [
    {
      "id": "figure2a_psmi",
      "group": "paper_figure_2a",
      "seed": 42,
      "config": "configs/experiments/main_benchmark_stage1.yaml",
      "checkpoint": "models/paper_historical/figure2a_psmi/best_model.pt",
      "fg_corpus": "experiments/paper_historical/figure2a_psmi/artifacts/fg_corpus.json",
      "reference_predictions": "experiments/paper_historical/figure2a_psmi/predictions/test_df_raw_pointwise_predictions.csv",
      "set": [
        "MIXTURE_NODE_LAYOUT=legacy_component_major"
      ],
      "allow_input_hash_mismatch": true
    },
    {
      "id": "table3_data_driven",
      "group": "paper_table_3",
      "seed": 42,
      "config": "configs/experiments/main_benchmark_stage1.yaml",
      "checkpoint": "models/paper_historical/table3_data_driven/best_model.pt",
      "fg_corpus": "experiments/paper_historical/table3_data_driven/artifacts/fg_corpus.json",
      "reference_predictions": "experiments/paper_historical/table3_data_driven/predictions/test_df_raw_pointwise_predictions.csv",
      "set": [
        "MIXTURE_NODE_LAYOUT=legacy_component_major"
      ],
      "allow_input_hash_mismatch": true
    },
    {
      "id": "table3_physics_informed",
      "group": "paper_table_3",
      "seed": 42,
      "config": "configs/experiments/main_benchmark_stage1.yaml",
      "checkpoint": "models/paper_historical/table3_physics_informed/best_model.pt",
      "fg_corpus": "experiments/paper_historical/table3_physics_informed/artifacts/fg_corpus.json",
      "reference_predictions": "experiments/paper_historical/table3_physics_informed/predictions/test_df_raw_pointwise_predictions.csv",
      "set": [
        "MIXTURE_NODE_LAYOUT=legacy_component_major"
      ],
      "allow_input_hash_mismatch": true,
      "allow_derived_scalers": true
    }
  ]
}
