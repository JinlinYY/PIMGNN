{
  "dataset": "datasets/processed/update-LLE-all-with-smiles_min3.xlsx",
  "checkpoint": "models/paper_historical/figure2a_psmi/best_model.pt",
  "models": [
    "data_only",
    "margules",
    "nrtl",
    "van_laar"
  ],
  "seeds": [
    42,
    43,
    44,
    45,
    46
  ],
  "split": {
    "train": 0.8,
    "validation": 0.1,
    "test": 0.1,
    "by": "system_id"
  },
  "min_tie_lines_per_system_temperature": 6,
  "permutation_augmentation": "identity_plus_swap_components_2_and_3",
  "parameter_fit_scope": "training_systems_only",
  "parameter_fit_steps": 1000,
  "finetune_epochs": 30,
  "finetune_learning_rate": 5e-06,
  "lambda_phy": 0.001,
  "freeze_backbone": true
}
